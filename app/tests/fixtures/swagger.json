          }
        },
        "summary": "V1 Health Check Ping.",
        "tags": [
          "Public"
        ]
      }
    },
    "/api/v1/public/stats": {
      "get": {
        "responses": {
          "200": {
            "description": "Public system statistics."
          },
          "401": {
            "description": "Missing or invalid API key."
          }
        },
        "security": [
          {
            "APIKeyAuth": []
          }
        ],
        "summary": "Public System Statistics (Requires API Key).",
        "tags": [
          "Public"
        ]
      }
    },
    "/api/v1/tradelines": {
      "get": {
        "parameters": [
          {
            "default": 10,
            "description": "Number of records to return (1-100).",
            "in": "query",
            "name": "limit",
            "type": "integer"
          },
          {
            "default": 0,
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of tradelines."
          }
        },
        "summary": "Fetches paginated tradelines belonging to the authenticated user.",
        "tags": [
          "Tradelines"
        ]
      },
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "account_number": {
                  "example": "ACC-99281",
                  "type": "string"
                },
                "balance": {
                  "example": 1500.5,
                  "type": "number"
                },
                "creditor_name": {
                  "example": "Chase Bank",
                  "type": "string"
                },
                "date_opened": {
                  "example": "2023-01-15",
                  "format": "date",
                  "type": "string"
                }
              },
              "required": [
                "account_number",
                "balance",
                "date_opened"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tradeline created successfully."
          },
          "422": {
            "description": "Validation error or invalid payload format."
          }
        },
        "summary": "Creates a new tradeline record for the authenticated user.",
        "tags": [
          "Tradelines"
        ]
      }
    },
    "/api/v1/tradelines/review/{tradeline_id}": {
      "post": {
        "parameters": [
          {
            "description": "Unique identifier of the tradeline.",
            "in": "path",
            "name": "tradeline_id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "action": {
                  "enum": [
                    "approve",
                    "reject"
                  ],
                  "example": "approve",
                  "type": "string"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tradeline review processed successfully.",
            "schema": {
              "properties": {
                "message": {
                  "example": "Tradeline 1 approved successfully.",
                  "type": "string"
                },
                "status": {
                  "example": "success",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "400": {
            "description": "Invalid action parameter.",
            "schema": {
              "properties": {
                "error": {
                  "example": "invalid_action",
                  "type": "string"
                },
                "message": {
                  "example": "action must be 'approve' or 'reject'",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "summary": "Review a tradeline endpoint exposed at /api/v1/tradelines/review/<id>.",
        "tags": [
          "Tradelines"
        ]
      }
    },
    "/api/v1/tradelines/{tradeline_id}": {
      "delete": {
        "parameters": [
          {
            "description": "Unique identifier of the tradeline.",
            "in": "path",
            "name": "tradeline_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Tradeline deleted successfully."
          },
          "404": {
            "description": "Tradeline not found or access denied."
          }
        },
        "summary": "Deletes a specific tradeline record with ownership verification.",
        "tags": [
          "Tradelines"
        ]
      },
      "get": {
        "parameters": [
          {
            "description": "Unique identifier of the tradeline.",
            "in": "path",
            "name": "tradeline_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Tradeline details."
          },
          "404": {
            "description": "Tradeline not found or access denied."
          }
        },
        "summary": "Retrieves a single tradeline record verified by user ownership.",
        "tags": [
          "Tradelines"
        ]
      },
      "put": {
        "parameters": [
          {
            "description": "Unique identifier of the tradeline.",
            "in": "path",
            "name": "tradeline_id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "body",
            "name": "body",
            "required": false,
            "schema": {
              "properties": {
                "balance": {
                  "example": 1200.0,
                  "type": "number"
                },
                "creditor_name": {
                  "example": "Wells Fargo",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tradeline updated successfully."
          },
          "404": {
            "description": "Tradeline not found or access denied."
          },
          "422": {
            "description": "Invalid input payload."
          }
        },
        "summary": "Updates an existing tradeline record with user authorization check.",
        "tags": [
          "Tradelines"
        ]
      }
    }
  },
  "swagger": "2.0"
}