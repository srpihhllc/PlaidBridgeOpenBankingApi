  "paths": {
    "/api/": {
      "get": {
        "responses": {
          "200": {
            "description": "Server heartbeat and API version discovery context.",
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "available_versions": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "message": {
                  "type": "string"
                },
                "success": {
                  "example": true,
                  "type": "boolean"
                },
                "version": {
                  "example": "generic",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "summary": "Returns a server heartbeat and API version discovery context.",
        "tags": [
          "System Discovery"
        ]
      }
    },
    "/api/dashboard_settings/dark_mode": {
