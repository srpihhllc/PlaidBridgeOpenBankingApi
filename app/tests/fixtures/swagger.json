          "403": {
            "description": "Subscriber role required."
          },
          "500": {
            "description": "Database operation failure."
          }
        },
        "summary": "Toggle dark mode choices across user dashboard context rows.",
        "tags": [
          "Subscriber Settings"
        ]
      }
    },
