        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "email": {
                  "example": "user@example.com",
                  "type": "string"
                },
                "mfa_code": {
                  "example": "123456",
                  "type": "string"
                },
                "password": {
                  "example": "SecretPass123!",
                  "type": "string"
                }
              },
              "required": [
                "email",
                "password"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful. Returns access and refresh tokens."
          },
          "401": {
            "description": "Invalid credentials or missing MFA code."
          },
          "403": {
            "description": "Account pending administrative approval."
          }
        },
        "summary": "User authentication and JWT token issuance.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "mfa_code": {
                  "example": "123456",
                  "type": "string"
                }
              },
              "required": [
                "mfa_code"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "MFA verified and enabled."
          },
          "401": {
            "description": "Invalid MFA code."
          },
          "422": {
            "description": "Missing MFA code."
          }
        },
        "summary": "Verifies MFA code and enables MFA on the current user account.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "email": {
                  "example": "user@example.com",
                  "type": "string"
                },
                "password": {
                  "example": "SecretPass123!",
                  "type": "string"
                },
                "username": {
                  "example": "johndoe",
                  "type": "string"
                }
              },
              "required": [
                "email",
                "password",
                "username"
              ],
              "type": "object"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Registration successful."
          },
          "422": {
            "description": "Validation error or existing entity."
          }
        },
        "summary": "Register a new user account with defensive input checks.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/token/refresh": {
      "post": {
        "responses": {
          "200": {
            "description": "New access token generated."
          }
        },
        "summary": "Refreshes the JWT access token using a valid refresh token.",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "responses": {
          "200": {
            "description": "System operating normally."
          },
          "503": {
            "description": "Database or downstream dependency outage."
          }
        },
        "summary": "Detailed V1 System Health Status.",
