# PlaidBridgeOpenBankingApi example configuration.
# Copy to .env for local development, then add only the credentials you need.
# Never commit real credentials or secrets.

# -----------------------------------------------------------------------------
# Core Flask Runtime Environment Hooks
# -----------------------------------------------------------------------------
# Allowed: development, testing, staging, production
FLASK_APP=manage.py
FLASK_ENV=development
ENV_NAME=development
FLASK_CONFIG=development
FLASK_DEBUG=True
PORT=3000
LOG_LEVEL=INFO

# Development-only fallbacks are provided by app/config.py.
# Set strong, unique values through the deployment environment in production.
# SECRET_KEY=
# JWT_SECRET_KEY=

# -----------------------
# Webhook secrets
# -----------------------
# ACH_WEBHOOK_SECRET=
# RECONCILE_WEBHOOK_SECRET=
# POLSIA_WEBHOOK_SECRET=

# -----------------------
# Plaid
# -----------------------
PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_API_BASE_URL=

# -----------------------
# Treasury Prime
# -----------------------
TREASURY_PRIME_ENV=sandbox
TREASURY_PRIME_SANDBOX_API_URL=https://api.sandbox.treasuryprime.com
TREASURY_PRIME_PRODUCTION_API_URL=https://api.treasuryprime.com
# TREASURY_PRIME_SANDBOX_API_KEY=
# TREASURY_PRIME_PRODUCTION_API_KEY=

# -----------------------
# OAuth / external apps
# -----------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -----------------------
# Database
# -----------------------
# Preferred: provide all DB_* values so the application builds the URI.
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306
# DB_NAME=

# Alternatively, set a complete URI in the deployment environment.
# Do not commit a URI containing credentials.
# SQLALCHEMY_DATABASE_URI=

# -----------------------
# Redis
# -----------------------

# Production Redis Cloud endpoint.
# REDIS_URL takes precedence over REDIS_STORAGE_URI; keep both aligned.

REDIS_URL=redis://default:@redis-12744.c309.us-east-2-1.ec2.cloud.redislabs.com:12744
REDIS_STORAGE_URI=redis://default:@redis-12744.c309.us-east-2-1.ec2.cloud.redislabs.com:12744

# Dedicated broker isolation (/1 if supported by provider, otherwise use a separate instance)
CELERY_BROKER_URL=redis://default:@redis-12744.c309.us-east-2-1.ec2.cloud.redislabs.com:12744

# -----------------------
# Sync Worker (PythonAnywhere)
# -----------------------
MODE=pa
WORKER_SYNC_LIST_KEY=sync:jobs
REDIS_SOCKET_TIMEOUT=15

# -----------------------
# Sync worker
# -----------------------
MODE=pa
WORKER_SYNC_LIST_KEY=sync:jobs
WORKER_POLL_INTERVAL=1.0
# sync_worker.py currently uses a 5-second BLPOP timeout.
# REDIS_SOCKET_TIMEOUT must remain greater than that timeout.

# -----------------------
# Other datastores
# -----------------------
# COSMOS_DB_CONNECTION_STRING=

# -----------------------
# Application / demo accounts
# -----------------------
# Configure demo accounts only in isolated development or test environments.
# CLIENT_USER_ID=
# USER_EMAIL=
# USER_PASSWORD=
# ACCOUNT_NUMBER=
# OPERATOR_PASSWORD=
# OPERATOR_PASSPHRASE=
# GODS_MODE_PASSPHRASE=
# TERENCE_PASSPHRASE=
# MOCK_USERNAME=
# MOCK_PASSWORD=

# -----------------------
# Other API credentials
# -----------------------
# API_KEY=
# API_SECRET=
# PII_ENCRYPTION_KEY=
