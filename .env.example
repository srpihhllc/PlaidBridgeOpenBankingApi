# PlaidBridgeOpenBankingApi - combined .env.example (sanitized)
# IMPORTANT: Placeholders only. Never commit real secrets.
# Supply real values through the deployment environment or a secret manager.

# -----------------------
# App / Flask
# -----------------------
FLASK_APP=run.py
FLASK_ENV=production        # or "development"
FLASK_DEBUG=False
PORT=3000
LOG_LEVEL=INFO

# -----------------------
# Security keys
# -----------------------
SECRET_KEY=replace_with_secure_random_string
JWT_SECRET_KEY=replace_with_secure_random_string

# -----------------------
# Plaid
# -----------------------
PLAID_CLIENT_ID=replace_with_plaid_client_id
PLAID_SECRET=replace_with_plaid_secret
PLAID_PUBLIC_KEY=replace_with_plaid_public_key
PLAID_ENV=sandbox           # or "production"

# -----------------------
# Treasury Prime
# -----------------------
TREASURY_PRIME_SANDBOX_API_KEY=replace_with_treasuryprime_sandbox_key
TREASURY_PRIME_PRODUCTION_API_KEY=replace_with_treasuryprime_production_key
TREASURY_PRIME_SANDBOX_API_URL=https://api.sandbox.treasuryprime.com
TREASURY_PRIME_PRODUCTION_API_URL=https://api.treasuryprime.com
TREASURY_PRIME_ENV=sandbox

# -----------------------
# OAuth / External apps
# -----------------------
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# -----------------------
# Database (MySQL) - placeholders
# -----------------------
DB_USER=replace_with_db_user
DB_PASSWORD=replace_with_db_password
DB_HOST=replace_with_db_host
DB_PORT=3306
DB_NAME=replace_with_db_name

# Optional: the application may build its connection string from the variables above.
# Do not commit credentials in a database URI.
# Example only:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
SQLALCHEMY_DATABASE_URI=replace_with_sqlalchemy_database_uri_if_needed

# -----------------------
# Redis
# -----------------------
# Canonical name used here: REDIS_STORAGE_URI
REDIS_STORAGE_URI=redis://:replace_with_redis_password@replace_with_redis_host:6379/0
# If the application expects REDIS_URL, map REDIS_STORAGE_URI to it in runtime config.


# -----------------------
# Sync worker (PythonAnywhere)
# -----------------------
# Staging Redis — replace placeholders with the provider's TLS endpoint
REDIS_URL=rediss://:YOUR_URL_ENCODED_PASSWORD@YOUR_TLS_HOST:YOUR_TLS_PORT/0
CELERY_BROKER_URL=rediss://:YOUR_URL_ENCODED_PASSWORD@YOUR_TLS_HOST:YOUR_TLS_PORT/0

# Staging sync worker
MODE=pa
WORKER_SYNC_LIST_KEY=sync:jobs
REDIS_SOCKET_TIMEOUT=15

# -----------------------
# Cosmos / other datastores
# -----------------------
COSMOS_DB_CONNECTION_STRING=replace_with_cosmos_connection_string

# -----------------------
# Application / demo accounts and credentials
# -----------------------
CLIENT_USER_ID=replace_with_client_user_id
USER_EMAIL=replace_with_user_email
USER_PASSWORD=replace_with_user_password
ACCOUNT_NUMBER=replace_with_account_number
OPERATOR_PASSWORD=replace_with_operator_password
OPERATOR_PASSPHRASE=replace_with_operator_passphrase
GODS_MODE_PASSPHRASE=replace_with_gods_mode_passphrase
TERENCE_PASSPHRASE=replace_with_terence_passphrase

# Mock/demo accounts
MOCK_USERNAME=replace_with_mock_username
MOCK_PASSWORD=replace_with_mock_password

# -----------------------
# API keys / other secrets
# -----------------------
API_KEY=replace_with_api_key
API_SECRET=replace_with_api_secret

# -----------------------
# Notes
# -----------------------
# - Rotate any credentials exposed in commits or logs.
# - Supply real secrets only through the deployment environment or a secret manager.
# - Enable secret scanning and pre-commit checks to prevent accidental leaks.
# - After scrubbing history, rescan it and remove any remote refs that retain secrets.
# - A separate Bash console does not automatically inherit the web app's environment.
#   Set the required variables independently in each worker console.
# - The current sync worker's process_job function is a placeholder; these variables
#   alone do not provide provider-to-database synchronization.
# - Implement real provider processing and persistence before treating a job as synced.
# - The worker must handle Redis BLPOP timeouts and continue polling instead of exiting.
# - WORKER_REDIS_SOCKET_TIMEOUT is not effective until worker Redis configuration reads it.
